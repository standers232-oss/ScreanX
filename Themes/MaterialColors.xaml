<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme (Default) - Material 3 Purple Iris Palette -->
    <Color x:Key="ColorPrimary">#D0BCFF</Color>
    <Color x:Key="ColorOnPrimary">#381E72</Color>
    <Color x:Key="ColorPrimaryContainer">#4F378B</Color>
    <Color x:Key="ColorOnPrimaryContainer">#EADDFF</Color>

    <Color x:Key="ColorSecondary">#CCC2DC</Color>
    <Color x:Key="ColorOnSecondary">#332D41</Color>
    <Color x:Key="ColorSecondaryContainer">#4A4458</Color>
    <Color x:Key="ColorOnSecondaryContainer">#E8DEF8</Color>

    <Color x:Key="ColorTertiary">#EFB8C8</Color>
    <Color x:Key="ColorOnTertiary">#492532</Color>
    <Color x:Key="ColorTertiaryContainer">#633B48</Color>
    <Color x:Key="ColorOnTertiaryContainer">#FFD8E4</Color>

    <Color x:Key="ColorSurface">#141218</Color>
    <Color x:Key="ColorSurfaceDim">#141218</Color>
    <Color x:Key="ColorSurfaceBright">#3B383E</Color>
    <Color x:Key="ColorSurfaceContainerLowest">#0F0D13</Color>
    <Color x:Key="ColorSurfaceContainerLow">#1D1B20</Color>
    <Color x:Key="ColorSurfaceContainer">#211F26</Color>
    <Color x:Key="ColorSurfaceContainerHigh">#2B2930</Color>
    <Color x:Key="ColorSurfaceContainerHighest">#36343B</Color>

    <Color x:Key="ColorOnSurface">#E6E0E9</Color>
    <Color x:Key="ColorOnSurfaceVariant">#CAC4D0</Color>
    <Color x:Key="ColorOutline">#938F99</Color>
    <Color x:Key="ColorOutlineVariant">#49454F</Color>
    <Color x:Key="ColorInverseSurface">#E6E0E9</Color>
    <Color x:Key="ColorInverseOnSurface">#313033</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="M3.PrimaryBrush" Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="M3.OnPrimaryBrush" Color="{StaticResource ColorOnPrimary}"/>
    <SolidColorBrush x:Key="M3.PrimaryContainerBrush" Color="{StaticResource ColorPrimaryContainer}"/>
    <SolidColorBrush x:Key="M3.OnPrimaryContainerBrush" Color="{StaticResource ColorOnPrimaryContainer}"/>

    <SolidColorBrush x:Key="M3.SecondaryBrush" Color="{StaticResource ColorSecondary}"/>
    <SolidColorBrush x:Key="M3.OnSecondaryBrush" Color="{StaticResource ColorOnSecondary}"/>
    <SolidColorBrush x:Key="M3.SecondaryContainerBrush" Color="{StaticResource ColorSecondaryContainer}"/>
    <SolidColorBrush x:Key="M3.OnSecondaryContainerBrush" Color="{StaticResource ColorOnSecondaryContainer}"/>

    <SolidColorBrush x:Key="M3.TertiaryBrush" Color="{StaticResource ColorTertiary}"/>
    <SolidColorBrush x:Key="M3.OnTertiaryBrush" Color="{StaticResource ColorOnTertiary}"/>
    <SolidColorBrush x:Key="M3.TertiaryContainerBrush" Color="{StaticResource ColorTertiaryContainer}"/>
    <SolidColorBrush x:Key="M3.OnTertiaryContainerBrush" Color="{StaticResource ColorOnTertiaryContainer}"/>

    <SolidColorBrush x:Key="M3.SurfaceBrush" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="M3.SurfaceDimBrush" Color="{StaticResource ColorSurfaceDim}"/>
    <SolidColorBrush x:Key="M3.SurfaceBrightBrush" Color="{StaticResource ColorSurfaceBright}"/>
    <SolidColorBrush x:Key="M3.SurfaceContainerLowestBrush" Color="{StaticResource ColorSurfaceContainerLowest}"/>
    <SolidColorBrush x:Key="M3.SurfaceContainerLowBrush" Color="{StaticResource ColorSurfaceContainerLow}"/>
    <SolidColorBrush x:Key="M3.SurfaceContainerBrush" Color="{StaticResource ColorSurfaceContainer}"/>
    <SolidColorBrush x:Key="M3.SurfaceContainerHighBrush" Color="{StaticResource ColorSurfaceContainerHigh}"/>
    <SolidColorBrush x:Key="M3.SurfaceContainerHighestBrush" Color="{StaticResource ColorSurfaceContainerHighest}"/>

    <SolidColorBrush x:Key="M3.OnSurfaceBrush" Color="{StaticResource ColorOnSurface}"/>
    <SolidColorBrush x:Key="M3.OnSurfaceVariantBrush" Color="{StaticResource ColorOnSurfaceVariant}"/>
    <SolidColorBrush x:Key="M3.OutlineBrush" Color="{StaticResource ColorOutline}"/>
    <SolidColorBrush x:Key="M3.OutlineVariantBrush" Color="{StaticResource ColorOutlineVariant}"/>
    <SolidColorBrush x:Key="M3.InverseSurfaceBrush" Color="{StaticResource ColorInverseSurface}"/>
    <SolidColorBrush x:Key="M3.InverseOnSurfaceBrush" Color="{StaticResource ColorInverseOnSurface}"/>

    <!-- Accent Shadows / Elevation -->
    <DropShadowEffect x:Key="M3.Elevation1" BlurRadius="6" ShadowDepth="1" Opacity="0.25" Direction="270" Color="#000000"/>
    <DropShadowEffect x:Key="M3.Elevation2" BlurRadius="12" ShadowDepth="3" Opacity="0.30" Direction="270" Color="#000000"/>
    <DropShadowEffect x:Key="M3.Elevation3" BlurRadius="18" ShadowDepth="6" Opacity="0.35" Direction="270" Color="#000000"/>
</ResourceDictionary>
