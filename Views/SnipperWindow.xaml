<Window x:Class="ScreanX.Views.SnipperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreanX Sniper" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        Focusable="True"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Grid x:Name="RootGrid" MouseDown="RootGrid_MouseDown" MouseMove="RootGrid_MouseMove" MouseUp="RootGrid_MouseUp">
        <!-- 1. Background Captured Screen Image -->
        <Image x:Name="BackgroundImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- 2. Dark Overlay Dimming (with cutout for selection) -->
        <Path x:Name="DarkOverlayPath" Fill="#70000000"/>

        <!-- 3. Selection Border & Handles -->
        <Canvas x:Name="OverlayCanvas">
            <!-- Selection Box -->
            <Border x:Name="SelectionBorder" BorderBrush="{DynamicResource M3.PrimaryBrush}" BorderThickness="2" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
            </Border>

            <!-- Dimensions Badge -->
            <Border x:Name="DimensionBadge" Background="{DynamicResource M3.SurfaceContainerHighestBrush}" 
                    CornerRadius="12" Padding="8,4" Visibility="Collapsed" Effect="{StaticResource M3.Elevation2}">
                <TextBlock x:Name="DimensionText" Foreground="{DynamicResource M3.OnSurfaceBrush}" 
                           FontSize="12" FontWeight="SemiBold" Text="0 × 0 px"/>
            </Border>

            <!-- Annotations Layer -->
            <Canvas x:Name="AnnotationCanvas" Visibility="Collapsed"/>

            <!-- Floating Loupe / Magnifier (follows cursor before selection) -->
            <Border x:Name="LoupeContainer" Width="140" Height="140" CornerRadius="70" 
                    BorderBrush="{DynamicResource M3.PrimaryBrush}" BorderThickness="3" 
                    Background="{DynamicResource M3.SurfaceContainerHighestBrush}" 
                    Effect="{StaticResource M3.Elevation3}" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Clip>
                    <EllipseGeometry Center="70,70" RadiusX="67" RadiusY="67"/>
                </Border.Clip>
                <Grid>
                    <!-- Zoomed Image -->
                    <Image x:Name="LoupeImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    
                    <!-- Center Crosshair -->
                    <Line X1="0" Y1="70" X2="140" Y2="70" Stroke="{DynamicResource M3.PrimaryBrush}" StrokeThickness="1" Opacity="0.8"/>
                    <Line X1="70" Y1="0" X2="70" Y2="140" Stroke="{DynamicResource M3.PrimaryBrush}" StrokeThickness="1" Opacity="0.8"/>
                    <Ellipse Width="10" Height="10" Stroke="{DynamicResource M3.PrimaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Bottom Info Pill -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8" 
                            Background="#D0000000" CornerRadius="10" Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="LoupeColorSwatch" Width="10" Height="10" CornerRadius="5" Margin="0,0,4,0"/>
                            <TextBlock x:Name="LoupeHexText" Foreground="White" FontSize="10" FontWeight="Bold" Text="#FFFFFF"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. Floating M3 Annotation Toolbar -->
            <Border x:Name="FloatingToolbar" Background="{DynamicResource M3.SurfaceContainerHighestBrush}" 
                    CornerRadius="24" Padding="6,4" Visibility="Collapsed" Effect="{StaticResource M3.Elevation3}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ToolbarScale" ScaleX="1.0" ScaleY="1.0"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- Tools Group -->
                    <RadioButton x:Name="ToolSelect" Style="{StaticResource M3.ToolButton}" ToolTip="Выделение (S)" IsChecked="True" Checked="Tool_Checked">
                        <Path Data="{StaticResource IconCursor}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="ToolArrow" Style="{StaticResource M3.ToolButton}" ToolTip="Стрелка (A)" Checked="Tool_Checked">
                        <Path Data="{StaticResource IconArrow}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="ToolRect" Style="{StaticResource M3.ToolButton}" ToolTip="Прямоугольник (R)" Checked="Tool_Checked">
                        <Path Data="{StaticResource IconRect}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="ToolEllipse" Style="{StaticResource M3.ToolButton}" ToolTip="Окружность (E)" Checked="Tool_Checked">
                        <Path Data="{StaticResource IconEllipse}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="ToolPen" Style="{StaticResource M3.ToolButton}" ToolTip="Карандаш (P)" Checked="Tool_Checked">
                        <Path Data="{StaticResource IconPen}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="ToolHighlighter" Style="{StaticResource M3.ToolButton}" ToolTip="Маркер (H)" Checked="Tool_Checked">
                        <Path Data="{StaticResource IconHighlighter}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="ToolStepBadge" Style="{StaticResource M3.ToolButton}" ToolTip="Номерной шаг (1, 2, 3...)" Checked="Tool_Checked">
                        <Path Data="{StaticResource IconStepBadge}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="ToolBlur" Style="{StaticResource M3.ToolButton}" ToolTip="Размытие / Цензура (B)" Checked="Tool_Checked">
                        <Path Data="{StaticResource IconBlur}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="ToolText" Style="{StaticResource M3.ToolButton}" ToolTip="Текст (T)" Checked="Tool_Checked">
                        <Path Data="{StaticResource IconText}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="24" Fill="{DynamicResource M3.OutlineVariantBrush}" Margin="6,0"/>

                    <!-- Color Swatches -->
                    <Button Width="22" Height="22" Margin="2,0" Background="#F44336" BorderThickness="0" Cursor="Hand" Click="Color_Click" Tag="#F44336">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11"/></ControlTemplate></Button.Template>
                    </Button>
                    <Button Width="22" Height="22" Margin="2,0" Background="#FF9800" BorderThickness="0" Cursor="Hand" Click="Color_Click" Tag="#FF9800">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11"/></ControlTemplate></Button.Template>
                    </Button>
                    <Button Width="22" Height="22" Margin="2,0" Background="#4CAF50" BorderThickness="0" Cursor="Hand" Click="Color_Click" Tag="#4CAF50">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11"/></ControlTemplate></Button.Template>
                    </Button>
                    <Button Width="22" Height="22" Margin="2,0" Background="#2196F3" BorderThickness="0" Cursor="Hand" Click="Color_Click" Tag="#2196F3">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11"/></ControlTemplate></Button.Template>
                    </Button>
                    <Button Width="22" Height="22" Margin="2,0" Background="#9C27B0" BorderThickness="0" Cursor="Hand" Click="Color_Click" Tag="#9C27B0">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11"/></ControlTemplate></Button.Template>
                    </Button>
                    <Button Width="22" Height="22" Margin="2,0" Background="#FFFFFF" BorderBrush="#888" BorderThickness="1" Cursor="Hand" Click="Color_Click" Tag="#FFFFFF">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"/></ControlTemplate></Button.Template>
                    </Button>

                    <!-- Stroke Size selector -->
                    <ComboBox x:Name="StrokeSizeCombo" Width="55" Height="28" Margin="6,0,2,0" SelectionChanged="StrokeSize_SelectionChanged"
                              Background="{DynamicResource M3.SurfaceContainerBrush}" Foreground="{DynamicResource M3.OnSurfaceBrush}"
                              BorderBrush="{DynamicResource M3.OutlineVariantBrush}" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="2 px"/>
                        <ComboBoxItem Content="4 px" IsSelected="True"/>
                        <ComboBoxItem Content="8 px"/>
                        <ComboBoxItem Content="14 px"/>
                    </ComboBox>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="24" Fill="{DynamicResource M3.OutlineVariantBrush}" Margin="6,0"/>

                    <!-- Undo / Redo -->
                    <Button Style="{StaticResource M3.IconButton}" ToolTip="Отменить (Ctrl+Z)" Click="Undo_Click">
                        <Path Data="{StaticResource IconUndo}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <!-- Pin to Desktop -->
                    <Button Style="{StaticResource M3.IconButton}" ToolTip="Закрепить на экране" Click="Pin_Click">
                        <Path Data="{StaticResource IconPin}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <!-- Save to File -->
                    <Button Style="{StaticResource M3.IconButton}" ToolTip="Сохранить в файл (Ctrl+S)" Click="Save_Click">
                        <Path Data="{StaticResource IconSave}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <!-- Record Video of Selected Region -->
                    <Button Style="{StaticResource M3.IconButton}" ToolTip="Записать видео этой области" Click="RecordVideo_Click">
                        <Path Data="{StaticResource IconVideo}" Fill="#F44336" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <!-- 2x HD Super-Sampling Toggle -->
                    <CheckBox x:Name="HDEnhanceToggle" Margin="4,0" Cursor="Hand" ToolTip="Супер-разрешение 2x: улучшает качество и чёткость текста для маленьких снимков" Click="HDEnhanceToggle_Click">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border x:Name="hdBorder" Height="30" CornerRadius="15" Padding="10,0" 
                                        Background="{DynamicResource M3.SurfaceContainerBrush}" 
                                        BorderBrush="{DynamicResource M3.OutlineVariantBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSparkles}" Width="13" Height="13" Stretch="Uniform" 
                                              Fill="{DynamicResource M3.PrimaryBrush}" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="hdText" Text="2x HD" FontSize="11" FontWeight="Bold" 
                                                   Foreground="{DynamicResource M3.OnSurfaceBrush}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="hdBorder" Property="Background" Value="{DynamicResource M3.PrimaryContainerBrush}"/>
                                        <Setter TargetName="hdBorder" Property="BorderThickness" Value="0"/>
                                        <Setter TargetName="hdText" Property="Foreground" Value="{DynamicResource M3.OnPrimaryContainerBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>

                    <!-- Copy to Clipboard (Filled Pill Button) -->
                    <Button Style="{StaticResource M3.FilledButton}" Height="34" Padding="14,0" Margin="4,0" ToolTip="Скопировать в буфер (Ctrl+C / Enter)" Click="Copy_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource M3.OnPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Копировать" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Cancel / Close -->
                    <Button Style="{StaticResource M3.IconButton}" ToolTip="Закрыть (Esc)" Click="Close_Click">
                        <Path Data="{StaticResource IconClose}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                </StackPanel>
            </Border>

        </Canvas>
    </Grid>
</Window>
