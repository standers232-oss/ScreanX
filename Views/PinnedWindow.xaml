<Window x:Class="ScreanX.Views.PinnedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinned Image" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown"
        MouseWheel="Window_MouseWheel"
        MouseDoubleClick="Window_MouseDoubleClick"
        Loaded="Window_Loaded">
    <Border x:Name="RootBorder" Background="{DynamicResource M3.SurfaceContainerBrush}" 
            BorderBrush="{DynamicResource M3.PrimaryBrush}" 
            BorderThickness="2" 
            CornerRadius="12" 
            Effect="{StaticResource M3.Elevation3}"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="BorderScale" ScaleX="0.88" ScaleY="0.88"/>
        </Border.RenderTransform>
        <Grid>
            <Image x:Name="PinnedImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="2"/>
            
            <!-- Quick Close Button on top right (visible on hover) -->
            <Button x:Name="CloseBtn" Style="{StaticResource M3.IconButton}" Width="28" Height="28" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Click="CloseBtn_Click" ToolTip="Закрыть (Двойной клик)">
                <Path Data="{StaticResource IconClose}" Fill="{DynamicResource M3.OnSurfaceBrush}" Width="12" Height="12" Stretch="Uniform"/>
            </Button>
        </Grid>
    </Border>
</Window>
