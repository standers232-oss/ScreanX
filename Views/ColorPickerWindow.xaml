<Window x:Class="ScreanX.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Color Picker" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown">

    <Canvas x:Name="PickerCanvas">
        <!-- Background captured desktop -->
        <Image x:Name="BgImage" Stretch="None"/>

        <!-- Loupe / Eyedropper Card -->
        <Border x:Name="LoupeCard" Width="180" Height="220" CornerRadius="16" 
                Background="{DynamicResource M3.SurfaceContainerBrush}" 
                BorderBrush="{DynamicResource M3.PrimaryBrush}" BorderThickness="2" 
                Effect="{StaticResource M3.Elevation3}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Zoomed Grid -->
                <Border Grid.Row="0" CornerRadius="8" BorderBrush="{DynamicResource M3.OutlineVariantBrush}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="ZoomImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Line X1="0" Y1="55" X2="156" Y2="55" Stroke="{DynamicResource M3.PrimaryBrush}" StrokeThickness="1" Opacity="0.8"/>
                        <Line X1="78" Y1="0" X2="78" Y2="110" Stroke="{DynamicResource M3.PrimaryBrush}" StrokeThickness="1" Opacity="0.8"/>
                    </Grid>
                </Border>

                <!-- Color Swatch & HEX -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4" VerticalAlignment="Center">
                    <Border x:Name="ColorBox" Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0" BorderBrush="{DynamicResource M3.OutlineBrush}" BorderThickness="1"/>
                    <TextBlock x:Name="HexText" Foreground="{DynamicResource M3.OnSurfaceBrush}" FontSize="15" FontWeight="Bold" Text="#FFFFFF"/>
                </StackPanel>

                <!-- RGB Text -->
                <TextBlock Grid.Row="2" x:Name="RgbText" Foreground="{DynamicResource M3.OnSurfaceVariantBrush}" FontSize="12" Text="RGB(255, 255, 255)"/>

                <!-- Hint -->
                <TextBlock Grid.Row="3" Foreground="{DynamicResource M3.PrimaryBrush}" FontSize="11" FontWeight="Medium" 
                           VerticalAlignment="Bottom" Text="Клик: скопировать | Esc: отмена"/>
            </Grid>
        </Border>
    </Canvas>
</Window>
