<Window x:Class="ScreanX.Views.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreanX Notification" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded">

    <Border x:Name="ToastCard" Margin="12" CornerRadius="24" 
            Background="{DynamicResource M3.InverseSurfaceBrush}" 
            Effect="{StaticResource M3.Elevation3}" 
            Padding="18,12" SnapsToDevicePixels="True"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTransform" Y="25"/>
        </Border.RenderTransform>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource M3.PrimaryBrush}" Margin="0,0,12,0">
                <Path x:Name="ToastIcon" Data="{StaticResource IconCheck}" Fill="{DynamicResource M3.OnPrimaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
            </Border>
            <TextBlock x:Name="ToastMessage" Foreground="{DynamicResource M3.InverseOnSurfaceBrush}" 
                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
