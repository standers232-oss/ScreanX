<Window x:Class="ScreanX.Views.RecordingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Recording" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Canvas x:Name="OverlayCanvas">
        <!-- Recording Area Frame with Pulsating Red/Primary Glow -->
        <Border x:Name="RecordingBorder" BorderBrush="#FF4444" BorderThickness="2" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FF0000" Opacity="0.6"/>
            </Border.Effect>
        </Border>

        <!-- Floating M3 Recording Bar (Draggable & Excluded from Capture) -->
        <Border x:Name="ControlBar" Background="{DynamicResource M3.SurfaceContainerHighestBrush}" 
                BorderBrush="{DynamicResource M3.OutlineVariantBrush}" BorderThickness="1"
                CornerRadius="24" Padding="12,6" Effect="{StaticResource M3.Elevation3}"
                Cursor="SizeAll" MouseDown="ControlBar_MouseDown" MouseMove="ControlBar_MouseMove" MouseUp="ControlBar_MouseUp">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- Drag Grip Dots -->
                <Path Data="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z" 
                      Fill="{DynamicResource M3.OnSurfaceVariantBrush}" Width="10" Height="14" Stretch="Uniform" Margin="2,0,8,0" Opacity="0.5"/>

                <!-- Pulsing Red Dot -->
                <Ellipse x:Name="RecDot" Width="12" Height="12" Fill="#FF3333" Margin="0,0,8,0" VerticalAlignment="Center"/>

                <!-- Timer Text -->
                <TextBlock x:Name="TimerText" Text="00:00" Foreground="{DynamicResource M3.OnSurfaceBrush}" 
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Resolution Pill -->
                <Border Background="{DynamicResource M3.SurfaceContainerBrush}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0">
                    <TextBlock x:Name="InfoText" Text="1920 × 1080 • REC" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource M3.PrimaryBrush}"/>
                </Border>

                <!-- Pause / Resume Button -->
                <Button x:Name="PauseBtn" Style="{StaticResource M3.IconButton}" Width="32" Height="32" Margin="0,0,4,0" ToolTip="Пауза" Click="PauseBtn_Click">
                    <Path x:Name="PauseIcon" Data="{StaticResource IconPause}" Fill="{DynamicResource M3.OnSurfaceBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </Button>

                <!-- Stop Recording Button (Filled Red Pill) -->
                <Button Style="{StaticResource M3.FilledButton}" Height="32" Padding="14,0" Margin="0,0,6,0" 
                        Background="#D32F2F" Foreground="White" ToolTip="Остановить и сохранить видео (Enter)" Click="StopBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconStop}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Завершить" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Cancel Button -->
                <Button Style="{StaticResource M3.IconButton}" Width="32" Height="32" ToolTip="Отменить запись (Esc)" Click="CancelBtn_Click">
                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource M3.OnSurfaceBrush}" Width="12" Height="12" Stretch="Uniform"/>
                </Button>

            </StackPanel>
        </Border>
    </Canvas>
</Window>
